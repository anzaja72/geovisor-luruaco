# Copia este archivo a .env.local (desarrollo) o .env.production (build).
# URL base de la API del backend.
VITE_API_URL=http://localhost:8080

# (Opcional) API key de ArcGIS Location Platform. Si se define, habilita la capa
# "Satelital HD (Esri)" como OPCIÓN en el selector de mapas base (no por defecto).
# Sin esta variable, el default es imagen libre (Sentinel-2) y Esri no aparece.
# Restringe la key por dominio (referrer) y a privilegio "Basemaps" en la consola de Esri.
# VITE_ARCGIS_API_KEY=
