# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas .env al repositorio.

# Opción A: cadena de conexión completa
# DATABASE_URL=postgres://usuario:password@host:5432/dbname?sslmode=require

# Opción B: variables sueltas (usadas si DATABASE_URL está vacía)
DB_HOST=localhost
DB_PORT=5432
DB_USER=eco_admin
DB_PASSWORD=
DB_NAME=restauracion_ecologica
DB_SSLMODE=disable

# Puerto del servidor HTTP
PORT=8080

# Orígenes permitidos para CORS (coma-separado). Usa tu dominio en producción.
# Ej: https://visor.midominio.com,http://localhost:5173
CORS_ALLOW_ORIGINS=http://localhost:5173
