# Variables del servidor MCP (sin secretos reales). En el VPS van en el .env raíz.
# Obligatorias
MCP_TOKEN_SECRET=         # >= 32 caracteres aleatorios: openssl rand -hex 32
MCP_PUBLIC_URL=https://mcp.luruacorenace.online
# Opcionales
BACKEND_URL=http://backend:8080
MCP_PORT=8090
MCP_RATE_PER_MIN=60              # peticiones por usuario y minuto
MCP_MAX_RESPONSE_BYTES=200000    # tope del texto devuelto por herramienta
MCP_TOKEN_TTL_HOURS=12
MCP_AUDIT_FILE=/var/log/mcp/audit.jsonl   # además de stdout
MCP_TRUST_PROXY=true             # IP real desde X-Forwarded-For (detrás de Traefik)
MCP_REDIRECT_HOSTS=claude.ai,claude.com,chatgpt.com,chat.openai.com,platform.openai.com,localhost,127.0.0.1
